{
  "name": "bot-rendiciones-viaticos",
  "version": "0.1.0",
  "description": "Bot WhatsApp para automatizar rendición de viaticos y gastos",
  "main": "src/index.js",
  "type": "module",
  "scripts": {
    "start": "node src/index.js",
    "commit": "node scripts/commit.js",
    "dev": "DEBUG=true node --watch src/index.js",
    "debug": "NODE_DEBUG=* node src/index.js",
    "test": "node --test tests/**/*.test.js",
    "db:generate": "dotenv -e env/.env -- prisma generate",
    "db:migrate": "dotenv -e env/.env -- prisma migrate dev",
    "db:migrate:prod": "prisma migrate deploy",
    "db:push": "dotenv -e env/.env -- prisma db push",
    "db:seed": "dotenv -e env/.env -- node prisma/seed.js",
    "db:studio": "dotenv -e env/.env -- prisma studio",
    "db:reset": "dotenv -e env/.env -- prisma migrate reset",
    "lint": "eslint src/",
    "format": "prettier --write src/",
    "clean:sessions": "rm -rf sessions/*",
    "clean:logs": "rm -rf logs/*",
    "clean:downloads": "rm -rf downloads/*"
  },
  "dependencies": {
    "@prisma/client": "^5.8.0",
    "axios": "^1.6.7",
    "bcrypt": "^5.1.1",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "joi": "^17.11.0",
    "puppeteer": "^21.6.1",
    "qrcode": "^1.5.3",
    "qrcode-terminal": "^0.12.0",
    "sharp": "^0.33.1",
    "tesseract.js": "^5.0.4",
    "whatsapp-web.js": "^1.25.0",
    "winston": "^3.11.0",
    "winston-daily-rotate-file": "^4.7.1"
  },
  "devDependencies": {
    "@types/node": "^20.10.6",
    "dotenv-cli": "^11.0.0",
    "eslint": "^8.56.0",
    "prettier": "^3.1.1",
    "prisma": "^5.8.0"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "keywords": [
    "whatsapp",
    "bot",
    "automation",
    "rendicion",
    "viaticos",
    "puppeteer",
    "baileys"
  ],
  "author": "Emanuel Perez",
  "license": "MIT"
}
