# ============================================
# .env.docker - REFERENCIA
# ============================================
# Este archivo documenta las variables de entorno para trabajar
# contra el PostgreSQL levantado con `docker-compose up`.
# Copiá los valores que necesites a tu `.env` real (nunca commitear `.env`).
# ============================================

# ============================================
# BASE DE DATOS - PostgreSQL (Docker)
# ============================================
# Coincide con las credenciales definidas en docker-compose.yml
DATABASE_URL="postgresql://bot_user:secure_password_123@localhost:5432/bot_rendiciones"

POSTGRES_USER="bot_user"
POSTGRES_PASSWORD="secure_password_123"
POSTGRES_DB="bot_rendiciones"
POSTGRES_HOST="localhost"
POSTGRES_PORT=5432

# ============================================
# WHATSAPP - Baileys
# ============================================
BAILEYS_SESSION_ID="default"
BAILEYS_AUTH_TIMEOUT=60000
BAILEYS_SYNC_INTERVAL=5000

# ============================================
# PUPPETEER - Automatización Web
# ============================================
PUPPETEER_HEADLESS=true
PUPPETEER_TIMEOUT=30000
PUPPETEER_SANDBOX=true
PUPPETEER_EXECUTABLE_PATH=""

# ============================================
# OCR - Tesseract.js
# ============================================
TESSERACT_LANGUAGE="es"
OCR_MIN_CONFIDENCE=0.75
OCR_TIMEOUT=30000

# ============================================
# REINTENTOS Y TIMEOUTS
# ============================================
RETRY_ATTEMPTS=3
RETRY_DELAY=5000
OPERATION_TIMEOUT=60000

# ============================================
# RUTAS Y DIRECTORIOS
# ============================================
PHOTOS_DIR="./downloads"
LOGS_DIR="./logs"
SESSIONS_DIR="./sessions"
LOG_FILE="./logs/bot.log"

# ============================================
# LOGGING
# ============================================
LOG_LEVEL="info"
LOG_TO_FILE=true
LOG_MAX_FILES=7
LOG_MAX_SIZE="20m"

# ============================================
# DEBUG Y DESARROLLO
# ============================================
DEBUG=false
PUPPETEER_DEBUG=false
SCREENSHOT_ON_ERROR=true
SCREENSHOTS_DIR="./screenshots"

# ============================================
# APLICACIONES EXTERNAS
# ============================================

# --- GPS (Seguimiento Global)
GPS_URL="https://mapas.seguimientoglobal.com/login"
GPS_USERNAME="tu_usuario_gps"
GPS_PASSWORD="tu_contraseña_gps"

# --- EMPRESA (La Segunda)
COMPANY_URL="https://app.lasegunda.com.ar"
COMPANY_USERNAME="tu_usuario_empresa"
COMPANY_PASSWORD="tu_contraseña_empresa"

# ============================================
# CONFIGURACIÓN DE APLICACIÓN
# ============================================
PORT=3000
APP_URL="http://localhost:3000"
NODE_ENV="development"

# ============================================
# NOTIFICACIONES (Futuro)
# ============================================
ADMIN_EMAIL="admin@example.com"
ERROR_WEBHOOK_URL=""

# ============================================
# SEGURIDAD
# ============================================
# ⚠️ Cambiar en producción. Este valor es solo para desarrollo local con Docker.
ENCRYPTION_KEY="tu_clave_secreta_muy_larga_y_segura"