# ============================================
# BASE DE DATOS - PostgreSQL
# ============================================
# Formato: postgresql://usuario:contraseña@localhost:5432/nombre_db
DATABASE_URL="postgresql://admin:password@localhost:5432/bot_rendiciones"

# Alternativa para Railway (Cloud)
# DATABASE_URL="postgresql://user:password@railway.app:5432/railway"

# ============================================
# WHATSAPP - Baileys
# ============================================
BAILEYS_SESSION_ID="default"
BAILEYS_AUTH_TIMEOUT=60000
BAILEYS_SYNC_INTERVAL=5000

# ============================================
# PUPPETEER - Automatización Web
# ============================================
# Usar navegador headless (sin interfaz gráfica)
PUPPETEER_HEADLESS=true

# Timeout global para Puppeteer (ms)
PUPPETEER_TIMEOUT=30000

# Ejecutar en modo sandbox (más seguro pero más lento)
PUPPETEER_SANDBOX=true

# Carpeta de descargas de Chrome si está instalado
PUPPETEER_EXECUTABLE_PATH=""

# ============================================
# OCR - Tesseract.js
# ============================================
# Idioma para OCR (es = español)
TESSERACT_LANGUAGE="es"

# Confianza mínima para aceptar OCR sin confirmación (0-1)
OCR_MIN_CONFIDENCE=0.75

# Timeout para OCR (ms)
OCR_TIMEOUT=30000

# ============================================
# REINTENTOS Y TIMEOUTS
# ============================================
# Número de intentos antes de fallar
RETRY_ATTEMPTS=3

# Delay entre reintentos (ms)
RETRY_DELAY=5000

# Timeout general para operaciones (ms)
OPERATION_TIMEOUT=60000

# ============================================
# RUTAS Y DIRECTORIOS
# ============================================
# Dónde guardar fotos descargadas
PHOTOS_DIR="./downloads"

# Dónde guardar logs
LOGS_DIR="./logs"

# Dónde guardar sesiones de Baileys
SESSIONS_DIR="./sessions"

# Archivo principal de log
LOG_FILE="./logs/bot.log"

# ============================================
# LOGGING
# ============================================
# Nivel de log: error, warn, info, http, debug, verbose, silly
LOG_LEVEL="info"

# Guarda logs en archivo
LOG_TO_FILE=true

# Número máximo de archivos de log a guardar
LOG_MAX_FILES=7

# Tamaño máximo de archivo de log (bytes)
LOG_MAX_SIZE="20m"

# ============================================
# DEBUG Y DESARROLLO
# ============================================
# Modo debug (más logs verbosos)
DEBUG=false

# Muestra logs de Puppeteer
PUPPETEER_DEBUG=false

# Tomar screenshots cuando falla algo
SCREENSHOT_ON_ERROR=true

# Carpeta de screenshots
SCREENSHOTS_DIR="./screenshots"

# ============================================
# APLICACIONES EXTERNAS
# ============================================

# --- GPS (Seguimiento Global)
GPS_URL="https://mapas.seguimientoglobal.com/login"
GPS_USERNAME="tu_usuario_gps"
GPS_PASSWORD="tu_contraseña_gps"

# --- EMPRESA (La Segunda)
COMPANY_URL="https://app.lasegunda.com.ar"
COMPANY_USERNAME="tu_usuario_empresa"
COMPANY_PASSWORD="tu_contraseña_empresa"

# ============================================
# CONFIGURACIÓN DE APLICACIÓN
# ============================================
# Puerto si alguna vez usas Express
PORT=3000

# URL base de la aplicación
APP_URL="http://localhost:3000"

# Ambiente: development, staging, production
NODE_ENV="development"

# ============================================
# NOTIFICACIONES (Futuro)
# ============================================
# Email para notificaciones de error
ADMIN_EMAIL="admin@example.com"

# Webhook de errores críticos
ERROR_WEBHOOK_URL=""

# ============================================
# SEGURIDAD
# ============================================
# Clave para encriptar credenciales
ENCRYPTION_KEY="tu_clave_secreta_muy_larga_y_segura"

# ============================================
# RAILWAY (Cuando deploys a cloud)
# ============================================
# Railway asigna automáticamente estas variables
# DATABASE_URL (se asigna automáticamente)
# NODE_ENV=production (se asigna automáticamente)

# Pero puedes agregar custom si quieres:
# RAILWAY_ENVIRONMENT_ID="xxx"
# RAILWAY_PROJECT_ID="xxx"
